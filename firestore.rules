rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/products/{productId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProduct() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'id', 'name', 'description', 'priceCop',
            'quantity', 'updatedAt', 'isDeleted'
          ])
          && d.id == productId
          && d.name is string && d.name.size() > 0
          && d.name.size() <= 80
          && d.description is string && d.description.size() <= 500
          && d.priceCop is int && d.priceCop >= 0
          && d.quantity is int && d.quantity >= 0
          && d.updatedAt is int
          && d.isDeleted is bool;
      }
      allow read: if isOwner();
      allow create, update: if isOwner() && validProduct();
      allow delete: if isOwner();
    }
  }
}
